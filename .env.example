# Supabase (Project Settings > API keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: used by the inbound email webhook. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of the deployed app, used in sign-in email links
NEXT_PUBLIC_SITE_URL=https://gifts.example.com

# Email inbox (optional until you set up Resend receiving)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
# Receiving domain, e.g. abc123.resend.app or gifts.example.com
INBOUND_EMAIL_DOMAIN=

# Reads forwarded emails (Claude API)
ANTHROPIC_API_KEY=sk-ant-...
